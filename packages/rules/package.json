{
  "name": "@apogee/rules",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "homepage": "https://apogee.build",
  "repository": {
    "type": "git",
    "url": "https://github.com/de-canter/apogee.git",
    "directory": "packages/rules"
  },
  "description": "Apogee rules: host-declared condition dimensions, natural-language rule parsing into assertions, validation, conflicts, two-layer evaluation, prompt compilation, audit",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "prepare": "tsup",
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@apogee/agent": "workspace:*",
    "@apogee/ai": "workspace:*",
    "@apogee/kernel": "workspace:*",
    "@apogee/prompts": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  }
}
