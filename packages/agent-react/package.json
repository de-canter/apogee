{
  "name": "@de_canter/apogee-agent-react",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "homepage": "https://apogee.build",
  "repository": {
    "type": "git",
    "url": "https://github.com/de-canter/apogee.git",
    "directory": "packages/agent-react"
  },
  "description": "React client for @de_canter/apogee-agent: SSE decoder, pure reducer, useAgentSession, and unstyled chat shells",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "prepare": "tsup",
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@de_canter/apogee-agent": "workspace:*",
    "@de_canter/apogee-ai": "workspace:*",
    "@de_canter/apogee-kernel": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@de_canter/apogee-prompts": "workspace:*",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0",
    "zod": "^4.0.0"
  }
}
