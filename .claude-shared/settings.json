{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "env": {
    "NODE_ENV": "development"
  },

  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",

    "alwaysApproveReadonly": [
      ".pnpm-store/",
      ".turbo/"
    ],

    "alwaysApproveTool": [
      "Skill(superpowers:dispatching-parallel-agents)",
      "Skill(code-review:code-review)"
    ],

    "alwaysDenyTool": [],

    "allow": [
      "Read(**)",
      "Read(//tmp/**)",

      "Edit(src/**)",
      "Edit(apps/**)",
      "Edit(packages/**)",
      "Edit(tests/**)",
      "Edit(test/**)",
      "Edit(__tests__/**)",
      "Edit(docs/**)",
      "Edit(scripts/**)",
      "Edit(*.md)",
      "Edit(*.json)",
      "Edit(*.ts)",
      "Edit(*.tsx)",
      "Edit(*.js)",
      "Edit(*.mjs)",
      "Edit(*.cjs)",
      "Edit(.claude/status.json)",
      "Edit(BLOCKED.md)",

      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(turbo:*)",
      "Bash(tsc:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(vitest:*)",
      "Bash(jest:*)",
      "Bash(playwright:*)",

      "Bash(git status:*)",
