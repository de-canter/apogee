      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Edit(**/secrets/**)",
      "Edit(**/credentials/**)",
      "Edit(**/.git/**)",
      "Edit(**/.ssh/**)",
      "Edit(**/.aws/**)",
      "Edit(**/pnpm-lock.yaml)",
      "Edit(**/package-lock.json)",
      "Edit(**/yarn.lock)",
      "Edit(**/.claude/settings.json)",
