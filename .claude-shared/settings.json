      "Bash(git reset --hard:*)",
      "Bash(git reset HEAD:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git tag:*)",
      "Bash(git remote add:*)",
      "Bash(git remote remove:*)",
      "Bash(git remote rm:*)",
      "Bash(git remote set-url:*)",
      "Bash(git config:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git filter-branch:*)",
      "Bash(git update-ref:*)",

      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(yarn publish:*)",

      "Bash(vercel deploy:*)",
      "Bash(vercel --prod:*)",
      "Bash(railway up:*)",
      "Bash(railway deploy:*)",
      "Bash(wrangler deploy:*)",
      "Bash(wrangler publish:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(az:*)",
      "Bash(kubectl:*)",
      "Bash(helm:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(docker push:*)",

      "Bash(mongosh* --eval *drop*)",
      "Bash(mongosh* --eval *deleteMany*)",
      "Bash(mongosh* --eval *remove*)",

      "Bash(curl*api.openai.com*)",
      "Bash(curl*api.anthropic.com*)",
      "Bash(curl*api.stripe.com*)",
      "Bash(curl*.clerk.accounts.dev*)",
      "Bash(curl* https://* -X POST *)",
      "Bash(curl* https://* -X PUT *)",
      "Bash(curl* https://* -X DELETE *)",
      "Bash(curl* https://* -X PATCH *)"
